\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces One FM pass on a six-tensor cut. An internal index crosses the cut (dashed) when it connects tensors on both sides; the cut cost is $\DOTSB \sum@ \slimits@ _\ell \log _2 d_\ell $ over crossing indices $\ell $ (red). Each tensor may move at most once per pass: each step moves the not-yet-moved tensor whose transfer most reduces the cut cost while keeping each side within an $18\%$ slack band of its initial size (and nonempty), then locks it; moves may be uphill. The pass ends when every tensor has moved or no legal move remains, and returns the \emph  {best cut encountered} along the way.}}{7}{figure.caption.7}\protected@file@percent }
\newlabel{fig:fmpass}{{2}{7}{One FM pass on a six-tensor cut. An internal index crosses the cut (dashed) when it connects tensors on both sides; the cut cost is $\sum _\ell \log _2 d_\ell $ over crossing indices $\ell $ (red). Each tensor may move at most once per pass: each step moves the not-yet-moved tensor whose transfer most reduces the cut cost while keeping each side within an $18\%$ slack band of its initial size (and nonempty), then locks it; moves may be uphill. The pass ends when every tensor has moved or no legal move remains, and returns the \emph {best cut encountered} along the way}{figure.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The annealer's local moves on a six-tensor toy network. Tensors sit at the leaves; the two red branches at the root define the current waist bipartition. Each TreeSA rewrite \cite  {kalachev_2021_multi} changes only the association of neighboring subtrees, so moving a tensor to the other side of the waist first requires walking it through the tree---and a global change of the waist requires traversing several intermediate trees, each scored on its own (Fig.~\ref {fig:escape}).}}{7}{figure.caption.8}\protected@file@percent }
\newlabel{fig:rewrites}{{3}{7}{The annealer's local moves on a six-tensor toy network. Tensors sit at the leaves; the two red branches at the root define the current waist bipartition. Each TreeSA rewrite \cite {kalachev_2021_multi} changes only the association of neighboring subtrees, so moving a tensor to the other side of the waist first requires walking it through the tree---and a global change of the waist requires traversing several intermediate trees, each scored on its own (Fig.~\ref {fig:escape})}{figure.caption.8}{}}
