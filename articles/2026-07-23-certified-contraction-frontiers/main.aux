\@writefile{loa}{\contentsline {algorithm}{\numberline {1}{\ignorespaces Global cut surgery. $\mathcal  {A}$ is a standard annealing engine (tuned per Sec.~\ref {sec:sctarget}); $w(A,B)$ is the summed $\log _2$ dimension of the labels straddling the bipartition $(A,B)$, excluding open output labels. All costs are recomputed exactly from the index dimensions; nothing is tuned per instance.}}{9}{algorithm.1}\protected@file@percent }
\newlabel{alg:surgery}{{1}{9}{Global cut surgery. $\mathcal {A}$ is a standard annealing engine (tuned per Sec.~\ref {sec:sctarget}); $w(A,B)$ is the summed $\log _2$ dimension of the labels straddling the bipartition $(A,B)$, excluding open output labels. All costs are recomputed exactly from the index dimensions; nothing is tuned per instance}{algorithm.1}{}}
