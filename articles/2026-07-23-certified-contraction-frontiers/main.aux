\newlabel{sec:anytime}{{5.2}{9}{Seeding and anytime behavior}{subsection.5.2}{}}
\citation{liu_2025_omeco_orders}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces One surgery iteration on a six-tensor toy network (Algorithm~\ref {alg:surgery}, lines 3--10). (a)~The most expensive tree node---the waist, red---divides the tensors into two subtrees. (b)~\emph  {Extract}: the two leaf sets become a cut of the original network, with the straddling indices (red) carrying the cut weight. (c)~\emph  {FM pass}: refinement moves tensors across the cut to reduce its cost (Fig.~\ref {fig:fmpass}). (d)~\emph  {Rebuild}: each side of the improved cut is ordered separately, the sides are joined, and the candidate tree is accepted only if its independently measured total cost decreases.}}{10}{figure.caption.10}\protected@file@percent }
\newlabel{fig:toysurgery}{{5}{10}{One surgery iteration on a six-tensor toy network (Algorithm~\ref {alg:surgery}, lines 3--10). (a)~The most expensive tree node---the waist, red---divides the tensors into two subtrees. (b)~\emph {Extract}: the two leaf sets become a cut of the original network, with the straddling indices (red) carrying the cut weight. (c)~\emph {FM pass}: refinement moves tensors across the cut to reduce its cost (Fig.~\ref {fig:fmpass}). (d)~\emph {Rebuild}: each side of the improved cut is ordered separately, the sides are joined, and the candidate tree is accepted only if its independently measured total cost decreases}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces The exact simplification pass on a six-tensor toy network. (a)~The pass greedily contracts adjacent (super-)tensors $A, B$ whenever $\mathrm  {rank}(A \cdot B) \le \max (\mathrm  {rank}(A), \mathrm  {rank}(B))$: here the shaded fragments absorb $x, y$ into $L_2$ and $z$ into $R_2$. (b)~The resulting super-tensors $L_2^{*}, R_2^{*}$ form a smaller network for the order search; their internal contractions are retained and restored in the final tree as fixed subtrees.}}{10}{figure.caption.11}\protected@file@percent }
\newlabel{fig:toysimplify}{{6}{10}{The exact simplification pass on a six-tensor toy network. (a)~The pass greedily contracts adjacent (super-)tensors $A, B$ whenever $\mathrm {rank}(A \cdot B) \le \max (\mathrm {rank}(A), \mathrm {rank}(B))$: here the shaded fragments absorb $x, y$ into $L_2$ and $z$ into $R_2$. (b)~The resulting super-tensors $L_2^{*}, R_2^{*}$ form a smaller network for the order search; their internal contractions are retained and restored in the final tree as fixed subtrees}{figure.caption.11}{}}
