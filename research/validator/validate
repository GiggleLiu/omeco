#!/usr/bin/env python3
"""Autoresearch validator CLI v2 — topic beat-existing-optimizers.

    validate <candidate-dir> [--precheck] [--as-reference NAME] [--out report.json]

OPTIMIZATION MODE (v2, user-directed 2026-07-22): no pass/fail bar. Two
fixed target instances (research/benchmark/targets/: reg3_250,
sycamore_m20) are optimized for minimum tc at a fixed per-instance budget;
research/validator/leaderboard.json holds the best-known tc per instance
(the "record"). A scored run reports each instance's tc and its delta to
the record; a run that beats a record triggers one confirmation run (fresh
relabeling) and the WORSE of the two results is recorded. Records are
seeded by reference rows (baseline TreeSA and the schedule-hygiene variant
from attempt-004), so schedule/parameter-only changes gain ~0 by
construction — only algorithm-level changes move the record.

ANYTIME MODE (v2.2, 2026-07-23): the harness polls the anytime out.json on
its own clock during every run, rescores each distinct snapshot from
topology, and reports the tc(t) curve, tc@{1,3,10,30}s, and TTF — the first
time the run is within TTF_EPS of the instance's pre-run tc record. A
per-instance TTF leaderboard (anytime_records) runs alongside the tc
records with the same confirm-twice / worse-of-two protocol; a TTF claim
needs a >=20% speedup. Candidate-declared timestamps are never consulted.

SCALE MODE (v2.3, 2026-07-23): the scale instances (reg3_1000, rqc_97_m24)
are ALWAYS scored as the median of 3 independent runs (fresh relabeling
each; failures count +inf), because single-run variance at n >= 1000
exceeds real method differences. `--scale` selects them as default targets;
runs touching a scale instance use a 1200 s wall limit. TTF records are
primaries-only (scale curves report-only).

Environment: fallback (no Docker) — sandbox-exec denies network and the
research/ tree is write-denied to attempts; wall-clock and CPU-time caps
enforced by this harness. Instances are randomly relabeled per run.

Exit codes: 0 scored, 1 rejected (invalid tree / cheating), 2 infra error.
"""

import argparse
import hashlib
import json
import math
import os
import pathlib
import random
import resource
import subprocess
import sys
import tempfile
import threading
import time

VALIDATOR_DIR = pathlib.Path(__file__).resolve().parent
REPO_ROOT = VALIDATOR_DIR.parent.parent
TARGETS_DIR = REPO_ROOT / "research" / "benchmark" / "targets"
DEV_DIR = REPO_ROOT / "research" / "benchmark" / "dev"
PRIV_DIR = REPO_ROOT / "research" / "benchmark" / "private"  # legacy, still sandbox-denied
LEADERBOARD = VALIDATOR_DIR / "leaderboard.json"

sys.path.insert(0, str(VALIDATOR_DIR))
from scorer import TreeError, score_tree  # noqa: E402

BUDGET_MS = 90_000.0  # optimizer budget per target instance
GRACE = 1.05
RECORD_EPS = 0.05  # minimum improvement to claim a record
WALL_LIMIT_S = 300  # STATE.md time_limit_seconds per scored run
FAIL_DELTA = -5.0  # delta contribution of a failed/timeout instance

# ---- v2.2 anytime mode (2026-07-23) ----
# The attempt contract already requires best-so-far writes to out.json; the
# harness polls that file on ITS OWN clock (candidate-declared times are never
# consulted, so checkpoint backdating is impossible by construction), rescores
# every distinct snapshot from topology, and derives the anytime curve.
# TTF (time-to-frontier) = first harness time at which the rescored tc is
# within TTF_EPS of the instance's pre-run record tc. TTF records use the same
# confirm-twice / worse-of-two protocol as tc records; a claim needs a
# TTF_RECORD_FACTOR speedup over the standing TTF record.
POLL_S = 0.2
TTF_EPS = 0.15
TTF_RECORD_FACTOR = 0.8  # new ttf must be < record_ttf * factor
TC_AT_CHECKPOINTS = [1.0, 3.0, 10.0, 30.0]

# ---- v2.3 scale mode (2026-07-23, user-approved) ----
# At n >= 1000 single-run variance (+/-1-5 log2) exceeds real method
# differences (cycle-5 finding), so scale instances are ALWAYS scored as the
# MEDIAN of 3 independent runs (fresh relabeling each; a failed run counts as
# +inf, so any failure pushes the median up). Runs touching a scale instance
# get a raised wall limit. TTF records/claims are disabled on scale instances
# (report-only) — the anytime board stays a primary-instance metric.
SCALE_INSTANCES = {"reg3_1000", "rqc_97_m24", "sycamore_53_20_0",
                   "surfacecode_d21", "ksg", "nqueens_28"}
SCALE_RUNS = 3
SCALE_WALL_LIMIT_S = 2400
# Default target groups: a bare scored run covers the primaries; --scale
# covers a 4-instance cross-family scale group that fits the wall with room
# for confirmation runs (other instances remain selectable via --targets).
PRIMARY_DEFAULT = {"reg3_250", "sycamore_m20"}
SCALE_DEFAULT = {"reg3_1000", "sycamore_53_20_0", "surfacecode_d21", "ksg"}


def log(*a):
    print("[validate]", *a, file=sys.stderr)


def sandbox_profile(candidate_dir, work_dir):
    return (
        "(version 1)\n"
        "(allow default)\n"
        "(deny network*)\n"
        f'(deny file-read* (subpath "{PRIV_DIR}"))\n'
        f'(deny file-write* (subpath "{PRIV_DIR}"))\n'
        f'(deny file-write* (subpath "{REPO_ROOT / "research"}"))\n'
    )


def run_sandboxed(cmd, candidate_dir, work_dir, timeout_s, env=None):
    prof = work_dir / "profile.sb"
    prof.write_text(sandbox_profile(candidate_dir, work_dir))
    full = ["/usr/bin/sandbox-exec", "-f", str(prof)] + cmd
    e = dict(os.environ)
    e.update(env or {})
    e["RAYON_NUM_THREADS"] = "1"
    start = time.monotonic()
    try:
        p = subprocess.run(full, cwd=candidate_dir, env=e, timeout=timeout_s,
                           capture_output=True, text=True)
        return p.returncode, (p.stderr or "")[-2000:], time.monotonic() - start, False
    except subprocess.TimeoutExpired as ex:
        stderr = ex.stderr.decode() if isinstance(ex.stderr, bytes) else (ex.stderr or "")
        return -9, stderr[-2000:], time.monotonic() - start, True


def permute_instance(graph, rng):
    labels = sorted(int(k) for k in graph["sizes"])
    shuffled = labels[:]
    rng.shuffle(shuffled)
    relabel = dict(zip(labels, shuffled))
    order = list(range(len(graph["ixs"])))
    rng.shuffle(order)
    return {
        "name": graph.get("name", "instance"),
        "description": graph.get("description", ""),
        "ixs": [[relabel[l] for l in graph["ixs"][i]] for i in order],
        "iy": [relabel[l] for l in graph["iy"]],
        "sizes": {str(relabel[int(k)]): v for k, v in graph["sizes"].items()},
    }


def load_leaderboard():
    if LEADERBOARD.exists():
        return json.load(open(LEADERBOARD))
    return {"records": {}, "reference_rows": {}, "sc_cap": {}}


def save_leaderboard(lb):
    json.dump(lb, open(LEADERBOARD, "w"), indent=2)


def environment_desc():
    lock = REPO_ROOT / "Cargo.lock"
    h = hashlib.sha256(lock.read_bytes()).hexdigest()[:16] if lock.exists() else "no-lock"
    return {"kind": "fallback",
            "image_or_lock": f"sandbox-exec+cargo-lock:{h}",
            "reason": "no Docker on this macOS host; sandbox-exec denies network "
                      "and research/ writes; harness enforces wall/CPU limits"}


def build_candidate(candidate_dir, work_dir, errors):
    build_sh = candidate_dir / "build.sh"
    if build_sh.exists():
        cmd = ["/bin/bash", str(build_sh)]
    else:
        cmd = ["/bin/bash", "-c",
               "cargo build --release --offline --example attempt -p omeco"]
    rc, err, secs, to = run_sandboxed(cmd, candidate_dir, work_dir, 300)
    if to or rc != 0:
        errors.append({"where": "build",
                       "what": f"build {'timed out' if to else f'failed rc={rc}'} "
                               f"after {secs:.0f}s",
                       "hint": "stderr tail: " + err[-500:]})
        return False
    return True


def attempt_cmd(candidate_dir, graph_path, budget_ms, out_path):
    sh = candidate_dir / "attempt.sh"
    if sh.exists():
        return ["/bin/bash", str(sh), str(graph_path), str(int(budget_ms)), str(out_path)]
    binp = candidate_dir / "target" / "release" / "examples" / "attempt"
    return [str(binp), str(graph_path), str(int(budget_ms)), str(out_path)]


def _poll_out(op, stop_evt, t0, snapshots):
    """Harness-clock poller: capture every distinct byte-state of the anytime
    output file as (t_rel_seconds, bytes). Candidate timestamps are ignored."""
    last_stat = None
    last_hash = None
    while True:
        try:
            st = op.stat()
            key = (st.st_size, st.st_mtime_ns)
            if key != last_stat:
                t_rel = time.monotonic() - t0
                data = op.read_bytes()
                h = hashlib.sha256(data).hexdigest()
                if h != last_hash:
                    snapshots.append((t_rel, data))
                    last_hash = h
                last_stat = key
        except OSError:
            pass
        if stop_evt.wait(POLL_S):
            # one final pass after process exit so the last write is captured
            try:
                data = op.read_bytes()
                h = hashlib.sha256(data).hexdigest()
                if h != last_hash:
                    snapshots.append((time.monotonic() - t0, data))
            except OSError:
                pass
            return


def anytime_curve(graph, snapshots, final_secs):
    """Rescore snapshots (skipping partial/garbage writes) into a monotone
    best-so-far curve [(t, tc, sc), ...]."""
    curve = []
    best = float("inf")
    for t_rel, data in snapshots:
        try:
            c_tc, c_sc, _ = score_tree(graph, json.loads(data))
        except (TreeError, ValueError, KeyError, TypeError, OSError):
            continue
        if c_tc < best - 1e-9:
            best = c_tc
            curve.append({"t": round(min(t_rel, final_secs), 3),
                          "tc": round(c_tc, 4), "sc": round(c_sc, 3)})
    return curve


def run_one(candidate_dir, work_dir, name, graph, budget_ms, errors):
    inst_dir = work_dir / f"{name}_{int(budget_ms)}_{int(time.monotonic()*1e3)}"
    inst_dir.mkdir(parents=True, exist_ok=True)
    gp = inst_dir / "graph.json"
    json.dump(graph, open(gp, "w"))
    op = inst_dir / "tree.json"
    deadline = max(budget_ms * GRACE / 1000.0, 0.2)
    cpu0 = resource.getrusage(resource.RUSAGE_CHILDREN)
    snapshots = []
    stop_evt = threading.Event()
    poller = threading.Thread(target=_poll_out,
                              args=(op, stop_evt, time.monotonic(), snapshots),
                              daemon=True)
    poller.start()
    rc, err, secs, timed_out = run_sandboxed(
        attempt_cmd(candidate_dir, gp, budget_ms, op),
        candidate_dir, work_dir, deadline)
    stop_evt.set()
    poller.join(timeout=5)
    cpu1 = resource.getrusage(resource.RUSAGE_CHILDREN)
    cpu_used = (cpu1.ru_utime + cpu1.ru_stime) - (cpu0.ru_utime + cpu0.ru_stime)
    if cpu_used > secs * 1.3 + 0.2:
        errors.append({"where": f"{name}@{int(budget_ms)}ms",
                       "what": f"resource-cap guard: CPU time {cpu_used:.2f}s > "
                               f"1.3x wall {secs:.2f}s — parallel execution "
                               "detected (single-thread protocol)",
                       "hint": "the budget is wall-clock at RAYON_NUM_THREADS=1; "
                               "remove thread pools / background processes"})
        return {"result": "invalid", "seconds": secs,
                "detail": f"cpu {cpu_used:.2f}s vs wall {secs:.2f}s"}
    if timed_out and not op.exists():
        errors.append({"where": f"{name}@{int(budget_ms)}ms",
                       "what": f"wall-clock limit exceeded ({secs * 1e3:.0f}ms > "
                               f"{budget_ms:.0f}ms budget +5% grace) and no tree "
                               "was written",
                       "hint": "attempt must write best-so-far tree before the "
                               "deadline; check the anytime write loop"})
        return {"result": "timeout", "seconds": secs, "detail": "killed at limit, no output"}
    if rc != 0 and not timed_out and not op.exists():
        escape = ("deny" in err.lower() or "not permitted" in err.lower())
        what = (f"attempt exited rc={rc} with no output"
                + ("; sandbox denial in stderr suggests an attempted "
                   "environment escape (network or out-of-dir read)" if escape else ""))
        errors.append({"where": f"{name}@{int(budget_ms)}ms", "what": what,
                       "hint": "stderr tail: " + err[-500:]})
        return {"result": "fail", "seconds": secs, "detail": "nonzero exit, no output"}
    try:
        tree_doc = json.load(open(op))
        tc, sc, _ = score_tree(graph, tree_doc)
    except TreeError as ex:
        errors.append({"where": f"{name}@{int(budget_ms)}ms",
                       "what": f"invalid contraction tree: {ex}",
                       "hint": "the scorer recomputes from topology; check leaf "
                               "coverage and output labels of the emitted tree"})
        return {"result": "invalid", "seconds": secs, "detail": str(ex)}
    except (json.JSONDecodeError, OSError, KeyError, TypeError) as ex:
        errors.append({"where": f"{name}@{int(budget_ms)}ms",
                       "what": f"unreadable tree JSON: {ex}",
                       "hint": "emit omeco writejson format"})
        return {"result": "invalid", "seconds": secs, "detail": f"bad json: {ex}"}
    return {"result": "ok", "seconds": secs, "tc": tc, "sc": sc,
            "curve": anytime_curve(graph, snapshots, secs),
            "detail": f"tc={tc:.3f} sc={sc:.3f}"}


def measure(candidate_dir, work, name, graph, budget, errors, rng, k):
    """k independent runs (fresh relabeling each); median-tc aggregate.

    Returns a run_one-shaped dict; for k>1 the median run's tree/curve is the
    representative, `all_runs` records every run, `seconds` is the total."""
    runs = []
    for i in range(k):
        res = run_one(candidate_dir, work, f"{name}_r{i + 1}" if k > 1 else name,
                      permute_instance(graph, rng), budget, errors)
        runs.append(res)
        if res["result"] == "invalid":
            return res  # cheating/contract violation: reject immediately
    if k == 1:
        return runs[0]
    tcs = sorted((r["tc"] if r["result"] == "ok" else float("inf"), i)
                 for i, r in enumerate(runs))
    med_tc, med_i = tcs[len(tcs) // 2]
    if med_tc == float("inf"):
        return next(r for r in runs if r["result"] != "ok")
    med = dict(runs[med_i])
    spread = ", ".join(f"{t:.3f}" if t != float("inf") else "fail" for t, _ in tcs)
    med["detail"] = f"median-of-{k} tc={med_tc:.3f} sc={med['sc']:.3f} (runs: {spread})"
    med["all_runs"] = [{"result": r["result"], "tc": r.get("tc"), "sc": r.get("sc"),
                        "seconds": round(r["seconds"], 3)} for r in runs]
    med["seconds"] = sum(r["seconds"] for r in runs)
    return med


def ttf_of(curve, frontier_tc):
    """First harness time within TTF_EPS of the frontier tc, else None."""
    if frontier_tc == float("inf"):
        return None
    for pt in curve:
        if pt["tc"] <= frontier_tc + TTF_EPS:
            return pt["t"]
    return None


def tc_at_of(curve):
    out = {}
    for ckpt in TC_AT_CHECKPOINTS:
        vals = [pt["tc"] for pt in curve if pt["t"] <= ckpt]
        out[str(ckpt)] = min(vals) if vals else None
    return out


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("candidate_dir")
    ap.add_argument("--precheck", action="store_true")
    ap.add_argument("--as-reference", default=None, metavar="NAME",
                    help="record results as a trusted reference row (bootstrap; "
                         "no confirmation runs; min-of-runs kept)")
    ap.add_argument("--targets", default=None,
                    help="comma-separated instance names to score (default: all "
                         "in targets dir); keeps scored runs inside the wall "
                         "limit now that the target set has grown")
    ap.add_argument("--scale", action="store_true",
                    help="score the scale instances (default targets = "
                         "reg3_1000,rqc_97_m24); scale instances always use "
                         "median-of-3 runs and the raised wall limit")
    ap.add_argument("--out", default="report.json")
    args = ap.parse_args()

    candidate_dir = pathlib.Path(args.candidate_dir).resolve()
    report = {"status": "error", "score": None, "per_instance": [], "errors": [],
              "record_updates": [], "environment": environment_desc()}
    errors = report["errors"]

    def finish(status, score=None, exit_code=0, extra=None):
        report["status"] = status
        report["score"] = score
        if extra:
            report.update(extra)
        json.dump(report, open(args.out, "w"), indent=2)
        log(f"status={status} score={score} records={report['record_updates']} -> {args.out}")
        sys.exit(exit_code)

    if not candidate_dir.is_dir():
        errors.append({"where": "precheck", "what": f"{candidate_dir} is not a directory",
                       "hint": "pass an attempt worktree"})
        finish("error", exit_code=2)

    work = pathlib.Path(tempfile.mkdtemp(prefix="validate_"))
    start = time.monotonic()

    # ---- cascade stage 1: build + structural precheck (free) ----
    if not build_candidate(candidate_dir, work, errors):
        finish("rejected", exit_code=1)
    tiny = json.load(open(DEV_DIR / "chain_10.json"))
    r = run_one(candidate_dir, work, "precheck_chain_10", tiny, 2000, errors)
    if r["result"] != "ok":
        errors.append({"where": "precheck",
                       "what": "candidate failed the free structural check on "
                               "chain_10 (2s budget)",
                       "hint": "fix contract compliance before scored runs; "
                               "see prior error entries"})
        finish("rejected", exit_code=1)
    if args.precheck:
        report["per_instance"] = [{"instance": "precheck_chain_10", "result": "pass",
                                   "seconds": r["seconds"],
                                   "detail": "structure ok (no score revealed)"}]
        finish("scored", score=None)

    # ---- scored run over the two targets ----
    lb = load_leaderboard()
    rng = random.Random(int.from_bytes(os.urandom(8), "big"))
    deltas = []
    rejected = False
    wanted = set(args.targets.split(",")) if args.targets else None
    if wanted is None:
        wanted = set(SCALE_DEFAULT) if args.scale else set(PRIMARY_DEFAULT)
    target_names = [p.stem for p in sorted(TARGETS_DIR.glob("*.json"))
                    if wanted is None or p.stem in wanted]
    wall_limit = (SCALE_WALL_LIMIT_S
                  if any(n in SCALE_INSTANCES for n in target_names)
                  else WALL_LIMIT_S)
    for path in sorted(TARGETS_DIR.glob("*.json")):
        name = path.stem
        if wanted is not None and name not in wanted:
            continue
        graph = json.load(open(path))
        is_scale = name in SCALE_INSTANCES
        k = SCALE_RUNS if is_scale else 1
        remaining = wall_limit - (time.monotonic() - start)
        if remaining < BUDGET_MS / 1000.0 * 0.5 * k:
            errors.append({"where": name,
                           "what": f"scored-run wall limit {wall_limit}s exhausted "
                                   "before this instance",
                           "hint": "raise time_limit_seconds in STATE.md or lower "
                                   "BUDGET_MS"})
            break
        budget = min(BUDGET_MS, remaining * 1000.0 / GRACE / k)
        res = measure(candidate_dir, work, name, graph, budget, errors, rng, k)
        entry = {"instance": name, "result": res["result"],
                 "seconds": round(res["seconds"], 3), "detail": res["detail"]}
        if "all_runs" in res:
            entry["all_runs"] = res["all_runs"]
        if res["result"] == "invalid":
            rejected = True
            report["per_instance"].append(entry)
            break
        if res["result"] != "ok":
            entry["result"] = res["result"]
            deltas.append(FAIL_DELTA)
            report["per_instance"].append(entry)
            continue
        tc, sc = res["tc"], res["sc"]
        # v2.1 (2026-07-23): pure-tc objective — sc unbounded, reported only.
        rec = lb["records"].get(name)
        rec_tc = rec["tc"] if rec else float("inf")
        delta = (rec_tc - tc) if rec else 0.0
        # v2.2: anytime metrics — frontier is the PRE-RUN tc record.
        curve = res.get("curve", [])
        ttf = ttf_of(curve, rec_tc)
        art = lb.setdefault("anytime_records", {})
        arec = art.get(name)
        arec_ttf = arec["ttf"] if arec else float("inf")
        entry["result"] = "pass"
        entry["anytime"] = {"ttf": ttf, "tc_at": tc_at_of(curve), "curve": curve}
        entry["detail"] += (f" record={rec_tc if rec else 'none'} delta={delta:+.3f}"
                            f" ttf={f'{ttf:.1f}s' if ttf is not None else 'inf'}"
                            f"/{f'{arec_ttf:.1f}s' if arec else 'none'}")
        deltas.append(delta)  # vs pre-run record; positive = beat the record
        # ---- record logic ----
        if args.as_reference:
            row = lb["reference_rows"].setdefault(name, {})
            prev = row.get(args.as_reference)
            if prev is None or tc < prev["tc"]:
                row[args.as_reference] = {"tc": tc, "sc": sc,
                                          "date": time.strftime("%Y-%m-%d")}
            arow = lb.setdefault("anytime_reference_rows", {}).setdefault(name, {})
            aprev = arow.get(args.as_reference)
            if (ttf is not None and not is_scale
                    and (aprev is None or ttf < aprev["ttf"])):
                arow[args.as_reference] = {"ttf": round(ttf, 3),
                                           "date": time.strftime("%Y-%m-%d")}
            if rec is None or tc < rec_tc:
                lb["records"][name] = {"tc": tc, "sc": sc,
                                       "by": f"ref:{args.as_reference}",
                                       "date": time.strftime("%Y-%m-%d"),
                                       "confirmed": True}
                report["record_updates"].append(
                    {"instance": name, "tc": tc, "by": f"ref:{args.as_reference}"})
            if (ttf is not None and not is_scale
                    and (arec is None or ttf < arec_ttf)):
                art[name] = {"ttf": round(ttf, 3), "by": f"ref:{args.as_reference}",
                             "date": time.strftime("%Y-%m-%d"), "confirmed": True}
                report["record_updates"].append(
                    {"instance": name, "ttf": round(ttf, 3),
                     "by": f"ref:{args.as_reference}"})
        else:
            tc_claim = rec is not None and tc < rec_tc - RECORD_EPS
            # first-ever TTF (arec None -> arec_ttf inf) is claimable too;
            # the confirmation run still applies. TTF claims are primaries-only.
            ttf_claim = (ttf is not None and not is_scale
                         and ttf < arec_ttf * TTF_RECORD_FACTOR)
            if tc_claim or ttf_claim:
                remaining = wall_limit - (time.monotonic() - start)
                if remaining > budget / 1000.0 * 0.5 * k:
                    confirm = measure(candidate_dir, work, name + "_confirm", graph,
                                      min(budget, remaining * 1000.0 / GRACE / k),
                                      errors, rng, k)
                    if confirm["result"] == "ok":
                        if tc_claim:
                            worse = max(tc, confirm["tc"])
                            if worse < rec_tc - RECORD_EPS:
                                lb["records"][name] = {
                                    "tc": worse, "sc": max(sc, confirm["sc"]),
                                    "by": str(candidate_dir.name),
                                    "date": time.strftime("%Y-%m-%d"),
                                    "confirmed": True}
                                report["record_updates"].append(
                                    {"instance": name, "tc": worse,
                                     "by": candidate_dir.name, "confirmed": True})
                                entry["detail"] += f" NEW RECORD {worse:.3f} (confirmed)"
                            else:
                                entry["detail"] += (f" record claim not confirmed "
                                                    f"(confirm tc={confirm['tc']:.3f})")
                        if ttf_claim:
                            c_ttf = ttf_of(confirm.get("curve", []), rec_tc)
                            worse_ttf = max(ttf, c_ttf) if c_ttf is not None else None
                            if (worse_ttf is not None
                                    and worse_ttf < arec_ttf * TTF_RECORD_FACTOR):
                                art[name] = {"ttf": round(worse_ttf, 3),
                                             "by": str(candidate_dir.name),
                                             "date": time.strftime("%Y-%m-%d"),
                                             "confirmed": True}
                                report["record_updates"].append(
                                    {"instance": name, "ttf": round(worse_ttf, 3),
                                     "by": candidate_dir.name, "confirmed": True})
                                entry["detail"] += (f" NEW TTF RECORD {worse_ttf:.1f}s "
                                                    "(confirmed)")
                            else:
                                entry["detail"] += (" ttf claim not confirmed "
                                                    f"(confirm ttf="
                                                    f"{c_ttf if c_ttf is not None else 'inf'})")
                    else:
                        entry["detail"] += " record claim: confirmation run failed"
                else:
                    entry["detail"] += " record claim: unconfirmed (wall limit)"
        report["per_instance"].append(entry)

    if rejected:
        finish("rejected", exit_code=1)
    save_leaderboard(lb)
    score = round(sum(deltas) / len(deltas), 4) if deltas else None
    finish("scored", score=score,
           extra={"leaderboard": lb["records"]})


if __name__ == "__main__":
    main()
